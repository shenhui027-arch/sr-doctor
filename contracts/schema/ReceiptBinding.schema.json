{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReceiptBinding",
  "type": "object",
  "required": [
    "component",
    "scope"
  ],
  "properties": {
    "component": {
      "$ref": "#/definitions/ReceiptComponent"
    },
    "scope": {
      "$ref": "#/definitions/ExportBindingScope"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ExportBindingScope": {
      "type": "string",
      "enum": [
        "exporter",
        "analysis",
        "comparison",
        "baseline",
        "candidate"
      ]
    },
    "ReceiptComponent": {
      "type": "object",
      "required": [
        "id",
        "manifest_hash",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "manifest_hash": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
