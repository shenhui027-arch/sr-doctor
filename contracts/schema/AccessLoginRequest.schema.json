{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccessLoginRequest",
  "description": "Input-only login account; like credentials, it is never echoed.",
  "type": "object",
  "required": [
    "password",
    "username"
  ],
  "properties": {
    "password": {
      "writeOnly": true,
      "type": "string"
    },
    "username": {
      "writeOnly": true,
      "type": "string"
    }
  },
  "additionalProperties": false
}
