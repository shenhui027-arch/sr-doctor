{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccessLoginRequest",
  "description": "Input-only access token; like credentials, it is never echoed.",
  "type": "object",
  "required": [
    "token"
  ],
  "properties": {
    "token": {
      "writeOnly": true,
      "type": "string"
    }
  },
  "additionalProperties": false
}
