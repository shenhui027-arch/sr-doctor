{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConnectedQuerySqlRequest",
  "description": "Narrow, session-owned lookup for SQL that was observed during the current discovery generation. Query lists intentionally omit this field.",
  "type": "object",
  "required": [
    "connection_id",
    "discovery_generation",
    "query_id"
  ],
  "properties": {
    "connection_id": {
      "type": "string"
    },
    "discovery_generation": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "query_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
