{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistorySeriesRequest",
  "type": "object",
  "required": [
    "baseline_hours",
    "current_hours",
    "points",
    "target",
    "template_key"
  ],
  "properties": {
    "baseline_hours": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "current_hours": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "points": {
      "description": "24..=168 hourly points ending with the current hour.",
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "target": {
      "type": "string"
    },
    "template_key": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
