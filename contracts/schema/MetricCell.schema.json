{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetricCell",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "bounds",
            "fidelity"
          ],
          "properties": {
            "bounds": {
              "type": "null"
            },
            "fidelity": {
              "$ref": "#/definitions/LosslessFidelity"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bounds",
            "fidelity"
          ],
          "properties": {
            "bounds": {
              "$ref": "#/definitions/BoundedInterval"
            },
            "fidelity": {
              "$ref": "#/definitions/BoundedFidelity"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bounds",
            "fidelity"
          ],
          "properties": {
            "bounds": {
              "type": "null"
            },
            "fidelity": {
              "$ref": "#/definitions/UnknownFidelity"
            }
          }
        }
      ],
      "required": [
        "canonical_number",
        "canonical_unit",
        "state"
      ],
      "properties": {
        "canonical_number": {
          "$ref": "#/definitions/CanonicalNumber"
        },
        "canonical_unit": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "exact"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "bounds",
        "canonical_number",
        "canonical_unit",
        "fidelity",
        "state"
      ],
      "properties": {
        "bounds": {
          "type": "null"
        },
        "canonical_number": {
          "type": "null"
        },
        "canonical_unit": {
          "type": "null"
        },
        "fidelity": {
          "type": "null"
        },
        "state": {
          "type": "string",
          "enum": [
            "missing"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "bounds",
        "canonical_number",
        "canonical_unit",
        "fidelity",
        "state"
      ],
      "properties": {
        "bounds": {
          "type": "null"
        },
        "canonical_number": {
          "type": "null"
        },
        "canonical_unit": {
          "type": "null"
        },
        "fidelity": {
          "type": "null"
        },
        "state": {
          "type": "string",
          "enum": [
            "invalid"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "bounds",
        "canonical_number",
        "canonical_unit",
        "fidelity",
        "state"
      ],
      "properties": {
        "bounds": {
          "type": "null"
        },
        "canonical_number": {
          "type": "null"
        },
        "canonical_unit": {
          "type": "null"
        },
        "fidelity": {
          "type": "null"
        },
        "state": {
          "type": "string",
          "enum": [
            "partial"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "bounds",
        "canonical_number",
        "canonical_unit",
        "fidelity",
        "state"
      ],
      "properties": {
        "bounds": {
          "type": "null"
        },
        "canonical_number": {
          "type": "null"
        },
        "canonical_unit": {
          "type": "null"
        },
        "fidelity": {
          "type": "null"
        },
        "state": {
          "type": "string",
          "enum": [
            "overflow"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "bounds",
        "canonical_number",
        "canonical_unit",
        "fidelity",
        "state"
      ],
      "properties": {
        "bounds": {
          "type": "null"
        },
        "canonical_number": {
          "type": "null"
        },
        "canonical_unit": {
          "type": "null"
        },
        "fidelity": {
          "type": "null"
        },
        "state": {
          "type": "string",
          "enum": [
            "unavailable"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "bounds",
        "canonical_number",
        "canonical_unit",
        "fidelity",
        "state"
      ],
      "properties": {
        "bounds": {
          "type": "null"
        },
        "canonical_number": {
          "type": "null"
        },
        "canonical_unit": {
          "type": "null"
        },
        "fidelity": {
          "type": "null"
        },
        "state": {
          "type": "string",
          "enum": [
            "incompatible"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "bounds",
        "canonical_number",
        "canonical_unit",
        "fidelity",
        "state"
      ],
      "properties": {
        "bounds": {
          "type": "null"
        },
        "canonical_number": {
          "type": "null"
        },
        "canonical_unit": {
          "type": "null"
        },
        "fidelity": {
          "type": "null"
        },
        "state": {
          "type": "string",
          "enum": [
            "unknown"
          ]
        }
      }
    }
  ],
  "required": [
    "display_text",
    "metric_cell_ref",
    "metric_id",
    "reasons",
    "source_refs",
    "subject_ref"
  ],
  "properties": {
    "display_text": {
      "type": "string"
    },
    "match_key": {
      "description": "Structural identity of the counter inside its subject: physical operator (fragment, pipeline, type, plan node, operator id) plus the raw counter name, which separates base/MIN/MAX statistics. Present only when unique within the report, so Compare can pair it across two Profiles of one plan; absent means it can not be paired unambiguously.",
      "type": [
        "string",
        "null"
      ]
    },
    "metric_cell_ref": {
      "type": "string"
    },
    "metric_id": {
      "type": "string"
    },
    "order_rank": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject_ref": {
      "type": "string"
    }
  },
  "definitions": {
    "BoundedFidelity": {
      "type": "string",
      "enum": [
        "rounded",
        "truncated",
        "interval"
      ]
    },
    "BoundedInterval": {
      "type": "object",
      "required": [
        "lower",
        "lower_inclusive",
        "upper",
        "upper_inclusive"
      ],
      "properties": {
        "lower": {
          "$ref": "#/definitions/CanonicalNumber"
        },
        "lower_inclusive": {
          "type": "boolean"
        },
        "upper": {
          "$ref": "#/definitions/CanonicalNumber"
        },
        "upper_inclusive": {
          "type": "boolean"
        }
      }
    },
    "CanonicalNumber": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/NumberKind"
        },
        "scale": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "value": {
          "description": "Base-10 only: JSON numbers are never used for counters.",
          "type": "string"
        }
      }
    },
    "LosslessFidelity": {
      "type": "string",
      "enum": [
        "exact"
      ]
    },
    "NumberKind": {
      "type": "string",
      "enum": [
        "integer",
        "decimal"
      ]
    },
    "UnknownFidelity": {
      "type": "string",
      "enum": [
        "unknown"
      ]
    }
  }
}
