{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileFetchRequest",
  "type": "object",
  "required": [
    "connection_id",
    "discovery_generation",
    "kind",
    "query_id"
  ],
  "properties": {
    "connection_id": {
      "type": "string"
    },
    "discovery_generation": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "kind": {
      "$ref": "#/definitions/ProfileFetchKind"
    },
    "query_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ProfileFetchKind": {
      "type": "string",
      "enum": [
        "baseline",
        "candidate_user_external_rerun"
      ]
    }
  }
}
