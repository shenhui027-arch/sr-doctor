{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoadOverviewResponse",
  "type": "object",
  "required": [
    "all_loads",
    "at_retention_limit",
    "by_kind",
    "groups",
    "hidden_system",
    "hour_axis_ticks",
    "hours",
    "limitations",
    "phases",
    "records_outside_hours",
    "routine",
    "summary",
    "support",
    "tables",
    "volume_axis_ticks",
    "volume_unit"
  ],
  "properties": {
    "all_loads": {
      "description": "Visible records of every group.",
      "type": "string"
    },
    "at_retention_limit": {
      "type": "boolean"
    },
    "batch": {
      "anyOf": [
        {
          "$ref": "#/definitions/BatchLoadDetail"
        },
        {
          "type": "null"
        }
      ]
    },
    "by_kind": {
      "description": "Most loads first.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/LoadKindCount"
      }
    },
    "complete_from": {
      "description": "From here on every manager in scope still holds its records; hours between the two, and the hour holding this time unless it is on the hour, are `partial`. Equal to `earliest_create_time` when one manager covers the scope.",
      "type": [
        "string",
        "null"
      ]
    },
    "earliest_create_time": {
      "description": "The oldest record in scope; hours before it are `unknown`.",
      "type": [
        "string",
        "null"
      ]
    },
    "failed_share_permyriad": {
      "description": "Failed over loads, 0..=10000; `None` with no loads.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint16",
      "minimum": 0.0
    },
    "fe_time_zone": {
      "type": [
        "string",
        "null"
      ]
    },
    "groups": {
      "description": "Task 56: every group among the visible records, whatever `kind` selects, in `LoadKindGroup` order; groups without records are left out.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/LoadGroupSummary"
      }
    },
    "hidden_system": {
      "type": "string"
    },
    "hour_axis_ticks": {
      "description": "Top first: the axis top, its half and zero.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hours": {
      "description": "Oldest first, ending at the hour of the newest record.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/LoadHourBucket"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "$ref": "#/definitions/LoadPhaseDistribution"
    },
    "records_outside_hours": {
      "description": "Records in scope that no drawn hour holds (no readable creation time, or older than `LOAD_OVERVIEW_MAX_HOURS`).",
      "type": "string"
    },
    "routine": {
      "$ref": "#/definitions/RoutineLoadOverview"
    },
    "routine_detail": {
      "anyOf": [
        {
          "$ref": "#/definitions/RoutineLoadDetail"
        },
        {
          "type": "null"
        }
      ]
    },
    "stream": {
      "description": "Only for the matching `kind`.",
      "anyOf": [
        {
          "$ref": "#/definitions/StreamLoadDetail"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "$ref": "#/definitions/LoadRecordsSummary"
    },
    "support": {
      "description": "Load records; Routine Load has its own in `routine`.",
      "allOf": [
        {
          "$ref": "#/definitions/LoadViewSupport"
        }
      ]
    },
    "tables": {
      "description": "Tables with filtered rows, most first.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/LoadTableBar"
      }
    },
    "volume_axis_ticks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "volume_unit": {
      "$ref": "#/definitions/LoadVolumeUnit"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "BatchLoadDetail": {
      "description": "INSERT or Broker Load: second-precision timings, source and sink counts.",
      "type": "object",
      "required": [
        "counts_unknown",
        "duration",
        "failure_reasons",
        "near_timeout_count",
        "running_states",
        "scan_bytes",
        "scan_rows",
        "slowest",
        "tables"
      ],
      "properties": {
        "counts_unknown": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/definitions/LoadDurationDistribution"
        },
        "failure_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoadFailureReason"
          }
        },
        "near_timeout_count": {
          "type": "string"
        },
        "running_states": {
          "description": "Loads not yet finished, by StarRocks' state.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoadStateCount"
          }
        },
        "scan_bytes": {
          "type": "string"
        },
        "scan_rows": {
          "type": "string"
        },
        "slowest": {
          "description": "Slowest finished first, at most `LOAD_OVERVIEW_SLOWEST`.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoadSlowRecord"
          }
        },
        "tables": {
          "description": "Most rows written first, at most `LOAD_OVERVIEW_TABLES`.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoadGroupTable"
          }
        }
      },
      "additionalProperties": false
    },
    "LoadDurationBin": {
      "type": "object",
      "required": [
        "loads",
        "lower_seconds",
        "permyriad"
      ],
      "properties": {
        "loads": {
          "type": "string"
        },
        "lower_seconds": {
          "type": "string"
        },
        "permyriad": {
          "description": "Against the fullest bin, 0..=10000.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "upper_seconds": {
          "description": "`None` for the open last bin.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LoadDurationDistribution": {
      "description": "Finish minus create in whole seconds, over finished records.",
      "type": "object",
      "required": [
        "bins",
        "samples"
      ],
      "properties": {
        "bins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoadDurationBin"
          }
        },
        "max_seconds": {
          "type": [
            "string",
            "null"
          ]
        },
        "p50_seconds": {
          "description": "Nearest rank; `None` below 20 samples.",
          "type": [
            "string",
            "null"
          ]
        },
        "p95_seconds": {
          "type": [
            "string",
            "null"
          ]
        },
        "samples": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LoadFailureReason": {
      "type": "object",
      "required": [
        "loads",
        "reason",
        "width_permyriad"
      ],
      "properties": {
        "latest_table": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_time": {
          "description": "When the newest failure of this reason finished (its creation time when the finish time is unknown); `latest_table` is the same record's.",
          "type": [
            "string",
            "null"
          ]
        },
        "loads": {
          "type": "string"
        },
        "reason": {
          "description": "`filtered_ratio`, `timeout`, `label_exists` or `other` for Stream Load; the `type:` StarRocks writes (`TIMEOUT`, `LOAD_RUN_FAIL`, ...) for INSERT and Broker Load.",
          "type": "string"
        },
        "width_permyriad": {
          "description": "Against the most frequent reason, 0..=10000.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "LoadGroupSummary": {
      "type": "object",
      "required": [
        "failed",
        "filtered_rows",
        "filtered_unknown",
        "group",
        "loads",
        "sink_rows",
        "sink_rows_unknown"
      ],
      "properties": {
        "failed": {
          "type": "string"
        },
        "filtered_rows": {
          "type": "string"
        },
        "filtered_unknown": {
          "type": "string"
        },
        "group": {
          "$ref": "#/definitions/LoadKindGroup"
        },
        "loads": {
          "type": "string"
        },
        "sink_rows": {
          "description": "`SINK_ROWS` summed over records that report it.",
          "type": "string"
        },
        "sink_rows_unknown": {
          "type": "string"
        },
        "total_p95_seconds": {
          "description": "Nearest rank of finish minus create (whole seconds) over finished records; `None` below 20 of them.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LoadGroupTable": {
      "description": "One table of one group. Sums cover records that report the value; `counts_unknown` records lack at least one of them.",
      "type": "object",
      "required": [
        "counts_unknown",
        "failed",
        "filtered_rows",
        "loads",
        "scan_bytes",
        "scan_rows",
        "sink_rows",
        "table"
      ],
      "properties": {
        "counts_unknown": {
          "type": "string"
        },
        "failed": {
          "type": "string"
        },
        "filtered_rows": {
          "type": "string"
        },
        "loads": {
          "type": "string"
        },
        "plan_p95_ms": {
          "description": "Stream Load only; `None` below 20 samples.",
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "description": "The most common priority (INSERT and Broker Load).",
          "type": [
            "string",
            "null"
          ]
        },
        "scan_bytes": {
          "type": "string"
        },
        "scan_rows": {
          "type": "string"
        },
        "sink_rows": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "total_p95_seconds": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LoadHourBucket": {
      "type": "object",
      "required": [
        "coverage",
        "failed",
        "failed_permyriad",
        "filtered_rows",
        "filtered_unknown",
        "hour",
        "loads",
        "loads_permyriad",
        "segments",
        "volume_unknown"
      ],
      "properties": {
        "coverage": {
          "$ref": "#/definitions/LoadHourCoverage"
        },
        "failed": {
          "type": "string"
        },
        "failed_permyriad": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "filtered_rows": {
          "type": "string"
        },
        "filtered_unknown": {
          "description": "Records of this hour whose filtered count is unknown.",
          "type": "string"
        },
        "hour": {
          "description": "`YYYY-MM-DD HH` in the FE time zone.",
          "type": "string"
        },
        "loads": {
          "type": "string"
        },
        "loads_permyriad": {
          "description": "Bar heights against the axis top, 0..=10000.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "segments": {
          "description": "Task 56: loads of each group, stacked in `LoadKindGroup` order.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoadHourSegment"
          }
        },
        "top_failed_count": {
          "type": [
            "string",
            "null"
          ]
        },
        "top_failed_table": {
          "description": "The table with the most failures in this hour, if any failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "volume": {
          "description": "Bytes for Stream Load, rows written otherwise (`volume_unit`), over records that report it; `volume_unknown` counts the others. `None` when the hour has loads and none of them reports it.",
          "type": [
            "string",
            "null"
          ]
        },
        "volume_permyriad": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        },
        "volume_unknown": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LoadHourCoverage": {
      "description": "How much of an hour the held records can speak for.",
      "oneOf": [
        {
          "description": "Every FE load manager in scope still holds this hour.",
          "type": "string",
          "enum": [
            "complete"
          ]
        },
        {
          "description": "Some manager in scope may already have dropped part of this hour: the counts are what is still held, a lower bound.",
          "type": "string",
          "enum": [
            "partial"
          ]
        },
        {
          "description": "Before the oldest record in scope: nothing is held, counts are not zero loads.",
          "type": "string",
          "enum": [
            "unknown"
          ]
        }
      ]
    },
    "LoadHourSegment": {
      "type": "object",
      "required": [
        "group",
        "loads",
        "permyriad"
      ],
      "properties": {
        "group": {
          "$ref": "#/definitions/LoadKindGroup"
        },
        "loads": {
          "type": "string"
        },
        "permyriad": {
          "description": "Against the hour axis top, 0..=10000.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "LoadKindCount": {
      "type": "object",
      "required": [
        "failed",
        "kind",
        "loads"
      ],
      "properties": {
        "failed": {
          "type": "string"
        },
        "kind": {
          "description": "StarRocks' `TYPE` text.",
          "type": "string"
        },
        "loads": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LoadKindGroup": {
      "description": "Task 56: the overview shows each group with only the measures StarRocks reports for it.",
      "type": "string",
      "enum": [
        "stream_load",
        "insert",
        "routine_load",
        "broker",
        "other"
      ]
    },
    "LoadPhaseBin": {
      "type": "object",
      "required": [
        "begin_txn",
        "begin_txn_permyriad",
        "lower_ms",
        "plan",
        "plan_permyriad",
        "receive_data",
        "receive_data_permyriad"
      ],
      "properties": {
        "begin_txn": {
          "type": "string"
        },
        "begin_txn_permyriad": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "lower_ms": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        },
        "plan_permyriad": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "receive_data": {
          "type": "string"
        },
        "receive_data_permyriad": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "upper_ms": {
          "description": "`None` for the open last bin.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LoadPhaseDistribution": {
      "type": "object",
      "required": [
        "axis_ticks",
        "begin_txn",
        "bins",
        "plan",
        "receive_data"
      ],
      "properties": {
        "axis_ticks": {
          "description": "Top first: the axis top, its half and zero.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "begin_txn": {
          "$ref": "#/definitions/LoadPhaseQuantiles"
        },
        "bins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoadPhaseBin"
          }
        },
        "plan": {
          "$ref": "#/definitions/LoadPhaseQuantiles"
        },
        "receive_data": {
          "$ref": "#/definitions/LoadPhaseQuantiles"
        }
      },
      "additionalProperties": false
    },
    "LoadPhaseQuantiles": {
      "type": "object",
      "required": [
        "samples"
      ],
      "properties": {
        "p50_ms": {
          "description": "Nearest rank; `None` with fewer than 20 samples.",
          "type": [
            "string",
            "null"
          ]
        },
        "p95_ms": {
          "type": [
            "string",
            "null"
          ]
        },
        "samples": {
          "description": "Records that report this phase.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LoadRecordsSummary": {
      "type": "object",
      "required": [
        "failed",
        "filtered_rows",
        "filtered_rows_unknown",
        "loaded_rows",
        "loaded_rows_unknown",
        "loads"
      ],
      "properties": {
        "begin_plan_p95_ms": {
          "description": "Nearest-rank P95 of begin-transaction plus plan time, over records that report both; `None` with fewer than 20 such records.",
          "type": [
            "string",
            "null"
          ]
        },
        "failed": {
          "type": "string"
        },
        "filtered_rows": {
          "type": "string"
        },
        "filtered_rows_unknown": {
          "type": "string"
        },
        "filtered_share_permyriad": {
          "description": "Filtered over filtered plus loaded rows, 0..=10000; `None` when any count is unknown or both sums are zero.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        },
        "loaded_rows": {
          "description": "Sums over records that report the count; unknown ones are counted apart and never added as zero.",
          "type": "string"
        },
        "loaded_rows_unknown": {
          "type": "string"
        },
        "loads": {
          "description": "Records StarRocks still holds (system loads excluded unless asked).",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LoadSlowRecord": {
      "type": "object",
      "required": [
        "execute_permyriad",
        "job_id",
        "label",
        "publish_permyriad",
        "table",
        "total_seconds"
      ],
      "properties": {
        "execute_permyriad": {
          "description": "Segment lengths against the slowest listed, 0..=10000.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "execute_seconds": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "publish_permyriad": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "publish_seconds": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_share_permyriad": {
          "description": "As `LoadRecord::timeout_share_permyriad`; may exceed 10000.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "total_seconds": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LoadSource": {
      "type": "object",
      "required": [
        "failed",
        "loads"
      ],
      "properties": {
        "client_ip": {
          "description": "`RUNTIME_DETAILS.client_ip`.",
          "type": [
            "string",
            "null"
          ]
        },
        "failed": {
          "type": "string"
        },
        "loads": {
          "type": "string"
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LoadStateCount": {
      "type": "object",
      "required": [
        "loads",
        "state"
      ],
      "properties": {
        "loads": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LoadTableBar": {
      "type": "object",
      "required": [
        "failed",
        "filtered_rows",
        "filtered_unknown",
        "loads",
        "table",
        "width_permyriad"
      ],
      "properties": {
        "failed": {
          "type": "string"
        },
        "filtered_rows": {
          "type": "string"
        },
        "filtered_unknown": {
          "type": "string"
        },
        "loads": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "width_permyriad": {
          "description": "Log-scaled against the largest, 0..=10000.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "LoadViewSupport": {
      "description": "What the connected version can show. 3.3+ is complete; 3.2 has Routine Load jobs without partition lag and no load records; 3.1 has neither.",
      "type": "string",
      "enum": [
        "full",
        "without_lag",
        "unsupported_version"
      ]
    },
    "LoadVolumeUnit": {
      "type": "string",
      "enum": [
        "bytes",
        "rows"
      ]
    },
    "RoutineJobHealth": {
      "description": "One Routine Load job's lifetime counters and what follows from them.",
      "type": "object",
      "required": [
        "db",
        "job_id",
        "name",
        "state",
        "state_class",
        "table"
      ],
      "properties": {
        "abort_share_permyriad": {
          "description": "Aborted over committed plus aborted, 0..=10000.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        },
        "aborted_tasks": {
          "type": [
            "string",
            "null"
          ]
        },
        "average_task_ms": {
          "description": "Task execution time over committed tasks.",
          "type": [
            "string",
            "null"
          ]
        },
        "committed_tasks": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_tasks": {
          "type": [
            "string",
            "null"
          ]
        },
        "db": {
          "type": "string"
        },
        "desired_tasks": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_rows": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_share_permyriad": {
          "description": "Error over total rows, 0..=10000.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        },
        "job_id": {
          "type": "string"
        },
        "load_rows_rate": {
          "description": "StarRocks' lifetime averages (rows or bytes over task execution time); `None` before the first committed task.",
          "type": [
            "string",
            "null"
          ]
        },
        "loaded_rows": {
          "type": [
            "string",
            "null"
          ]
        },
