{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoundedInterval",
  "type": "object",
  "required": [
    "lower",
    "lower_inclusive",
    "upper",
    "upper_inclusive"
  ],
  "properties": {
    "lower": {
      "$ref": "#/definitions/CanonicalNumber"
    },
    "lower_inclusive": {
      "type": "boolean"
    },
    "upper": {
      "$ref": "#/definitions/CanonicalNumber"
    },
    "upper_inclusive": {
      "type": "boolean"
    }
  },
  "definitions": {
    "CanonicalNumber": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/NumberKind"
        },
        "scale": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "value": {
          "description": "Base-10 only: JSON numbers are never used for counters.",
          "type": "string"
        }
      }
    },
    "NumberKind": {
      "type": "string",
      "enum": [
        "integer",
        "decimal"
      ]
    }
  }
}
