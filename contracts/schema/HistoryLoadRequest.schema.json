{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoryLoadRequest",
  "type": "object",
  "required": [
    "days"
  ],
  "properties": {
    "connection_id": {
      "description": "The connected session whose target to show; otherwise the most recently collected target.",
      "type": [
        "string",
        "null"
      ]
    },
    "days": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
