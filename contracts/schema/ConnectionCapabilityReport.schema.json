{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConnectionCapabilityReport",
  "type": "object",
  "required": [
    "audit",
    "explain_costs",
    "plan_advisor",
    "profile_fetch",
    "profile_list",
    "time_zone",
    "version_probe"
  ],
  "properties": {
    "audit": {
      "$ref": "#/definitions/ConnectionCapabilityState"
    },
    "audit_statement_filter": {
      "description": "`isQuery` (TINYINT) and `stmt` were both probed in this session, so the explicit statement-class filter can be applied without a fallback.",
      "default": "unknown",
      "allOf": [
        {
          "$ref": "#/definitions/ConnectionCapabilityState"
        }
      ]
    },
    "audit_user_filter": {
      "default": "unknown",
      "allOf": [
        {
          "$ref": "#/definitions/ConnectionCapabilityState"
        }
      ]
    },
    "explain_costs": {
      "$ref": "#/definitions/ConnectionCapabilityState"
    },
    "plan_advisor": {
      "$ref": "#/definitions/ConnectionCapabilityState"
    },
    "profile_fetch": {
      "$ref": "#/definitions/ConnectionCapabilityState"
    },
    "profile_list": {
      "$ref": "#/definitions/ConnectionCapabilityState"
    },
    "time_zone": {
      "$ref": "#/definitions/ConnectionCapabilityState"
    },
    "version_probe": {
      "$ref": "#/definitions/ConnectionCapabilityState"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ConnectionCapabilityState": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "forbidden",
        "unknown"
      ]
    }
  }
}
