{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoadOverviewRequest",
  "description": "Task 52: the load overview tab and the audit overview's load card. One read of `loads` and one of `routine_load_jobs`, summed by the server.",
  "type": "object",
  "required": [
    "connection_id",
    "include_system"
  ],
  "properties": {
    "connection_id": {
      "type": "string"
    },
    "include_system": {
      "type": "boolean"
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/definitions/LoadKindFilter"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "LoadKindFilter": {
      "type": "string",
      "enum": [
        "stream_load",
        "routine_load",
        "broker",
        "insert"
      ]
    }
  }
}
