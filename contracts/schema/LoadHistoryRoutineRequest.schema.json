{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoadHistoryRoutineRequest",
  "type": "object",
  "required": [
    "days"
  ],
  "properties": {
    "connection_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "days": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "job_id": {
      "description": "The job whose detail to show; the first job otherwise.",
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "description": "The collection target to show (task 59: a load alert names it); it wins over the connected session when known.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
