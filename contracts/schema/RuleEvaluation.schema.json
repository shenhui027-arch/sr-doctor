{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleEvaluation",
  "type": "object",
  "required": [
    "applicability_checks",
    "comparisons",
    "evidence_completeness",
    "evidence_completeness_reasons",
    "evidence_refs",
    "input_observation_refs",
    "limitations",
    "missing_prerequisites",
    "rule_id",
    "rule_version",
    "status",
    "threshold_receipts"
  ],
  "properties": {
    "applicability_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_completeness": {
      "$ref": "#/definitions/EvidenceCompleteness"
    },
    "evidence_completeness_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finding_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_observation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_id": {
      "type": "string"
    },
    "rule_version": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/RuleEvaluationStatus"
    },
    "subject_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "threshold_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "EvidenceCompleteness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "RuleEvaluationStatus": {
      "type": "string",
      "enum": [
        "triggered",
        "suspected",
        "not_triggered",
        "not_applicable",
        "suppressed"
      ]
    }
  }
}
