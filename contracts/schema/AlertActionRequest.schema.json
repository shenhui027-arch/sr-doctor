{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlertActionRequest",
  "type": "object",
  "required": [
    "action",
    "alert_id"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/AlertAction"
    },
    "alert_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AlertAction": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "acknowledge",
            "reopen"
          ]
        },
        {
          "description": "Silence for `ALERT_MUTE_HOURS`; no new alert for the template meanwhile.",
          "type": "string",
          "enum": [
            "mute"
          ]
        }
      ]
    }
  }
}
