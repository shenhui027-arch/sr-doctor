{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunningProfileCandidateListResponse",
  "type": "object",
  "required": [
    "at_limit",
    "candidates",
    "discovery_generation",
    "limit",
    "limitations",
    "local_truncated",
    "read_at_utc",
    "rejected",
    "returned",
    "source",
    "statement_filter"
  ],
  "properties": {
    "at_limit": {
      "description": "The actual, unfiltered ProfileList result reached the remote request cap.",
      "type": "boolean"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ConnectedQueryRef"
      }
    },
    "discovery_generation": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "limit": {
      "description": "Effective local maximum after bounded request normalization.",
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_truncated": {
      "description": "Running candidates exceeded the independent local limit.",
      "type": "boolean"
    },
    "profile_observed_at_utc": {
      "description": "ProfileList does not supply a source sampling timestamp in this contract.",
      "type": [
        "string",
        "null"
      ]
    },
    "read_at_utc": {
      "description": "API receipt time, not a source sampling timestamp.",
      "type": "string"
    },
    "rejected": {
      "description": "Running rows excluded because their retained shape, ID, or projection was invalid.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "returned": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "source": {
      "$ref": "#/definitions/QueryDiscoverySource"
    },
    "statement_filter": {
      "description": "What the requested statement filter did on the Running rows read this time: `not_applied` or `doctor_only_applied` with the hidden count.",
      "allOf": [
        {
          "$ref": "#/definitions/QueryListStatementFilterCoverage"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ConnectedPlanCheckAction": {
      "description": "The available arm must carry a session-owned capability reference. The unavailable arm cannot carry one, so invalid state/reference matrices are rejected by the wire contract rather than interpreted in the browser.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "plan_sql_ref",
            "reason",
            "state"
          ],
          "properties": {
            "plan_sql_ref": {
              "type": "string"
            },
            "reason": {
              "$ref": "#/definitions/PlanCheckAvailableReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "available"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "$ref": "#/definitions/PlanCheckUnavailableReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "unavailable"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ConnectedProfileFetchAction": {
      "description": "A Profile action is never an availability claim about the remote cache: `available` means the bounded fetch may be attempted for this row.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "$ref": "#/definitions/ProfileFetchAvailableReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "available"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "$ref": "#/definitions/ProfileFetchUnavailableReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "unavailable"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ConnectedQueryRef": {
      "type": "object",
      "required": [
        "connection_id",
        "plan_check",
        "profile_fetch",
        "query_id",
        "source_refs",
        "status",
        "timestamp_state"
      ],
      "properties": {
        "connection_id": {
          "type": "string"
        },
        "database": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "discovery_generation": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "discovery_source": {
          "anyOf": [
            {
              "$ref": "#/definitions/QueryDiscoverySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at_local": {
          "description": "Original bounded wall-clock text returned by Audit/ProfileList.",
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at_utc": {
          "description": "RFC 3339 text avoids a JavaScript-unsafe epoch-millisecond integer. `None` is required when a fetch response has only a query ID and no independently observed timestamp; the API must not invent UTC.",
          "type": [
            "string",
            "null"
          ]
        },
        "plan_check": {
          "$ref": "#/definitions/ConnectedPlanCheckAction"
        },
        "profile_fetch": {
          "$ref": "#/definitions/ConnectedProfileFetchAction"
        },
        "query_id": {
          "type": "string"
        },
        "query_time_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "resource_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "timestamp_state": {
          "$ref": "#/definitions/ConnectedTimestampState"
        }
      },
      "additionalProperties": false
    },
    "ConnectedTimestampState": {
      "description": "Records what the timestamp can prove. AuditLoader emits a wall-clock DATETIME without an origin offset, so a reader-session conversion is an interpretation rather than evidence of the producer's original instant.",
      "type": "string",
      "enum": [
        "reader_session_interpreted",
        "raw_wall_time_only",
        "unavailable"
      ]
    },
    "PlanCheckAvailableReason": {
      "type": "string",
      "enum": [
        "statement_retained"
      ]
    },
    "PlanCheckUnavailableReason": {
      "type": "string",
      "enum": [
        "statement_missing_or_not_select",
        "query_metadata_unavailable",
        "query_id_invalid",
        "query_id_duplicate"
      ]
    },
    "ProfileFetchAvailableReason": {
      "type": "string",
      "enum": [
        "can_be_attempted",
        "profile_fetched"
      ]
    },
    "ProfileFetchUnavailableReason": {
      "type": "string",
      "enum": [
        "query_id_invalid",
        "query_id_duplicate",
        "query_not_finished"
      ]
    },
    "QueryDiscoverySource": {
      "type": "string",
      "enum": [
        "audit",
        "profile_list"
      ]
    },
    "QueryListStatementFilterCoverage": {
      "description": "Outcome of the discovery list's statement-class filter. Counts are exact decimal source rows under the same window and status/digest filters and do not depend on the list limit. \"Not applied\", \"indistinguishable\" and a real zero stay distinct states.",
      "oneOf": [
        {
          "description": "`statement_filter = all`: nothing was hidden, so no hidden count exists.",
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not_applied"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "AuditLoader rows with a proven `isQuery` TINYINT and `stmt` column: the same predicate as the Audit history filter.",
          "type": "object",
          "required": [
            "hidden_doctor_row_count",
            "hidden_non_query_row_count",
            "state"
          ],
          "properties": {
            "hidden_doctor_row_count": {
              "description": "`isQuery = 1` rows whose `stmt` starts with this tool's marker.",
              "type": "string"
            },
            "hidden_non_query_row_count": {
              "description": "Rows whose `isQuery` is not 1 (including NULL).",
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "applied"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "ProfileList rows: `Statement` keeps this tool's marker, but the source has no statement-class column, so non-query statements (for example a load with a Profile) cannot be distinguished and stay visible.",
          "type": "object",
          "required": [
            "hidden_doctor_row_count",
            "state"
          ],
          "properties": {
            "hidden_doctor_row_count": {
              "description": "Marked rows among the bounded ProfileList rows read this time.",
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "doctor_only_applied"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "The resolved source cannot prove which rows this tool sent, so nothing was hidden. `reason` is a stable limitation code.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "indistinguishable"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
