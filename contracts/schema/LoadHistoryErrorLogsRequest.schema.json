{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoadHistoryErrorLogsRequest",
  "type": "object",
  "required": [
    "days",
    "offset"
  ],
  "properties": {
    "category": {
      "anyOf": [
        {
          "$ref": "#/definitions/LoadErrorCategory"
        },
        {
          "type": "null"
        }
      ]
    },
    "connection_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "days": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "offset": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "table": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "description": "The collection target to show (task 59: a load alert names it); it wins over the connected session when known.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "LoadErrorCategory": {
      "type": "string",
      "enum": [
        "out_of_range",
        "too_long",
        "column_count",
        "null_in_non_nullable",
        "out_of_partition",
        "json_cast",
        "json_structure",
        "other"
      ]
    }
  }
}
