{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GovernanceChangeRequest",
  "type": "object",
  "required": [
    "item_id",
    "note"
  ],
  "properties": {
    "change_seconds": {
      "description": "Defaults to now; never in the future.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "item_id": {
      "type": "string"
    },
    "note": {
      "description": "What was changed outside this tool; never SQL text.",
      "type": "string"
    }
  },
  "additionalProperties": false
}
