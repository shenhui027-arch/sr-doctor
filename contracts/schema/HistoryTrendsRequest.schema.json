{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoryTrendsRequest",
  "type": "object",
  "required": [
    "baseline_hours",
    "current_hours",
    "limit"
  ],
  "properties": {
    "baseline_hours": {
      "description": "24..=720 hours immediately before the current window.",
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "current_hours": {
      "description": "1..=168 hours ending with the current hour.",
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "limit": {
      "description": "1..=200 non-stable rows.",
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "target": {
      "description": "`host:port` as collected; `None` picks the most recently collected target.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
