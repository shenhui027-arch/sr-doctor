{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotifyTestRequest",
  "type": "object",
  "required": [
    "target"
  ],
  "properties": {
    "target": {
      "$ref": "#/definitions/NotifyTargetInput"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "NotifyChannelKind": {
      "type": "string",
      "enum": [
        "email",
        "feishu",
        "dingtalk",
        "aliyun_sms",
        "tencent_sms"
      ]
    },
    "NotifySeverity": {
      "description": "The lowest alert severity a target receives.",
      "type": "string",
      "enum": [
        "medium",
        "high"
      ]
    },
    "NotifyTargetInput": {
      "description": "A target to create (`target_id: None`), update, or test without saving. Secret fields left `None` keep what is saved.",
      "type": "object",
      "required": [
        "clear_signing_secret",
        "enabled",
        "kind",
        "min_severity",
        "name"
      ],
      "properties": {
        "address": {
          "description": "Email address (shown in full) or phone number (stored encrypted, shown masked). `None` keeps the saved phone number.",
          "type": [
            "string",
            "null"
          ]
        },
        "clear_signing_secret": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/definitions/NotifyChannelKind"
        },
        "min_severity": {
          "$ref": "#/definitions/NotifySeverity"
        },
        "name": {
          "type": "string"
        },
        "signing_secret": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "webhook": {
          "description": "Feishu / DingTalk webhook, stored encrypted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
