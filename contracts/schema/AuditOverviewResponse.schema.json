{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditOverviewResponse",
  "type": "object",
  "required": [
    "cluster_identity",
    "concurrency",
    "connection_id",
    "coverage",
    "discovery_generation",
    "family_top",
    "limitations",
    "primary",
    "schema_version",
    "scope"
  ],
  "properties": {
    "audit_timestamp_time_zone": {
      "anyOf": [
        {
          "$ref": "#/definitions/TimeZoneEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "cluster_identity": {
      "$ref": "#/definitions/AuditClusterIdentity"
    },
    "concurrency": {
      "$ref": "#/definitions/AuditConcurrencyPresentation"
    },
    "connection_id": {
      "type": "string"
    },
    "coverage": {
      "$ref": "#/definitions/AuditCoverage"
    },
    "discovery_generation": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "family_top": {
      "$ref": "#/definitions/AuditOverviewFamilyTopPresentation"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary": {
      "$ref": "#/definitions/AuditOverviewPrimaryPresentation"
    },
    "schema_version": {
      "$ref": "#/definitions/AuditWorkloadVersion"
    },
    "scope": {
      "$ref": "#/definitions/AuditScope"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AuditAggregateFact": {
      "type": "object",
      "required": [
        "aggregation",
        "metric"
      ],
      "properties": {
        "aggregation": {
          "$ref": "#/definitions/AuditAggregation"
        },
        "metric": {
          "$ref": "#/definitions/AuditMetricFact"
        },
        "source_nonnegative_count": {
          "description": "Source-side nonnegative numeric rows, not a second parser verdict.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "AuditAggregation": {
      "type": "string",
      "enum": [
        "sum",
        "max"
      ]
    },
    "AuditBoundedSourceCoverage": {
      "description": "The bounded source used by both the historical line and an active-at drill. This is deliberately partial: records that began before the fixed lookback are not read and must never be interpreted as zero in-flight work.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "lookback_seconds",
            "reason",
            "source_end_seconds",
            "source_start_seconds",
            "state"
          ],
          "properties": {
            "lookback_seconds": {
              "description": "Fixed configuration even when `source_start_seconds` saturates at Unix epoch zero; it is not a claimed observed maximum duration.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "reason": {
              "$ref": "#/definitions/AuditBoundedSourcePartialReason"
            },
            "source_end_seconds": {
              "description": "Exclusive source upper bound W1. It equals the public scope end.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "source_start_seconds": {
              "description": "Inclusive source lower bound B, in the same session-timezone timestamp domain as the scope bounds.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "state": {
              "type": "string",
              "enum": [
                "partial"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "AuditBoundedSourcePartialReason": {
      "type": "string",
      "enum": [
        "bounded_lookback"
      ]
    },
    "AuditClusterIdentity": {
      "oneOf": [
        {
          "description": "No native cross-connection cluster identity has been established.",
          "type": "object",
          "required": [
            "connection_id",
            "detected_version",
            "state"
          ],
          "properties": {
            "connection_id": {
              "type": "string"
            },
            "detected_version": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "session_scoped"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "AuditConcurrencyAxis": {
      "type": "object",
      "required": [
        "time_ticks"
      ],
      "properties": {
        "time_ticks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuditConcurrencyTimeTick"
          }
        }
      },
      "additionalProperties": false
    },
    "AuditConcurrencyCountTick": {
      "description": "A server-projected y-axis fact. The frontend never divides exact counts to manufacture intermediate ticks.",
      "type": "object",
      "required": [
        "active_count",
        "y_permyriad"
      ],
      "properties": {
        "active_count": {
          "type": "string"
        },
        "y_permyriad": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "AuditConcurrencyCoverage": {
      "description": "Source-side eligibility and exclusion facts for the bounded canonical cohort. These are not inferred from returned points or participant rows.",
      "type": "object",
      "required": [
        "canonical_bounded_event_count",
        "endpoint_overflow_count",
        "initial_active_count",
        "interval_count",
        "non_terminal_count",
        "query_time_negative_count",
        "query_time_overflow_count",
        "query_time_sql_null_count",
        "timestamp_invalid_count",
        "timestamp_missing_count",
        "transition_count",
        "zero_duration_count"
      ],
      "properties": {
        "canonical_bounded_event_count": {
          "type": "string"
        },
        "endpoint_overflow_count": {
          "type": "string"
        },
        "initial_active_count": {
          "description": "Active count at the inclusive public window start (W0).",
          "type": "string"
        },
        "interval_count": {
          "type": "string"
        },
        "non_terminal_count": {
          "type": "string"
        },
        "query_time_negative_count": {
          "type": "string"
        },
        "query_time_overflow_count": {
          "type": "string"
        },
        "query_time_sql_null_count": {
          "type": "string"
        },
        "timestamp_invalid_count": {
          "type": "string"
        },
        "timestamp_missing_count": {
          "type": "string"
        },
        "transition_count": {
          "description": "Exact number of unique in-window transition timestamps, before the transport point budget is applied.",
          "type": "string"
        },
        "zero_duration_count": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AuditConcurrencyPoint": {
      "description": "One inclusive start for a constant historical-in-flight segment. The right window endpoint is intentionally never a point. Exact count and time stay text; permyriad coordinates are layout only.",
      "type": "object",
      "required": [
        "active_count",
        "at_milliseconds",
        "label",
        "x_permyriad",
        "y_permyriad"
      ],
      "properties": {
        "active_count": {
          "type": "string"
        },
        "at_milliseconds": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "x_permyriad": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "y_permyriad": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "AuditConcurrencyPresentation": {
      "description": "Historical terminal audit interval projection. It is not a live-running, queueing, or blocking-query measurement.",
      "type": "object",
      "required": [
        "axis",
        "series",
        "source_coverage",
        "window"
      ],
      "properties": {
        "axis": {
          "$ref": "#/definitions/AuditConcurrencyAxis"
        },
        "coverage": {
          "description": "Absent when source schema types are unproven and the bounded source concurrency read was deliberately not issued. Absence never means 0.",
          "anyOf": [
            {
              "$ref": "#/definitions/AuditConcurrencyCoverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "series": {
          "$ref": "#/definitions/AuditConcurrencySeries"
        },
        "source_coverage": {
          "description": "The exact bounded source range for this line. It remains present even when schema capability makes the line unavailable.",
          "allOf": [
            {
              "$ref": "#/definitions/AuditBoundedSourceCoverage"
            }
          ]
        },
        "window": {
          "$ref": "#/definitions/AuditConcurrencyWindow"
        }
      },
      "additionalProperties": false
    },
    "AuditConcurrencySeries": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "count_ticks",
            "maximum_active_count",
            "points",
            "state"
          ],
          "properties": {
            "count_ticks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AuditConcurrencyCountTick"
              }
            },
            "maximum_active_count": {
              "description": "Largest exact active count across the returned full series. It is the y-projection denominator, never a UI-calculated number.",
              "type": "string"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AuditConcurrencyPoint"
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "exact"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "$ref": "#/definitions/AuditConcurrencyUnavailableReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "unavailable"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "AuditConcurrencyTimeTick": {
      "description": "A server-labelled x-axis location. The label is presentation text emitted in the source session's observed time zone; clients do not convert it.",
      "type": "object",
      "required": [
        "at_milliseconds",
        "label",
        "x_permyriad"
      ],
      "properties": {
        "at_milliseconds": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "x_permyriad": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "AuditConcurrencyUnavailableReason": {
      "oneOf": [
        {
          "description": "`SHOW COLUMNS` did not prove the fixed source arithmetic contract.",
          "type": "string",
          "enum": [
            "schema_type_unsupported"
          ]
        },
        {
          "description": "The exact source transition count exceeds the bounded transport shape; no partial line is returned.",
          "type": "string",
          "enum": [
            "transition_point_budget_exceeded"
          ]
        }
      ]
    },
    "AuditConcurrencyWindow": {
      "description": "Decimal text endpoints retain exact epoch-millisecond coordinates even when a caller's JavaScript Number would lose precision.",
      "type": "object",
      "required": [
        "end_milliseconds",
        "start_milliseconds"
      ],
      "properties": {
        "end_milliseconds": {
          "type": "string"
        },
        "start_milliseconds": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AuditCoverage": {
      "type": "object",
      "required": [
        "conflicting_duplicate_row_count",
        "error_count",
        "error_proportion",
        "exact_duplicate_row_count",
        "invalid_query_id_count",
        "metric_inputs",
        "missing_context_count",
        "missing_digest_count",
        "raw_row_count",
        "retained_event_count",
        "retained_family_count",
        "statement_filter"
      ],
      "properties": {
        "conflicting_duplicate_row_count": {
          "type": "string"
        },
        "error_count": {
          "description": "Exact ERR count among the retained canonical events in this scope.",
          "type": "string"
        },
        "error_proportion": {
          "description": "Exact ERR / retained-event fraction. It is not a rounded percentage.",
          "allOf": [
            {
              "$ref": "#/definitions/AuditErrorProportion"
            }
          ]
        },
        "exact_duplicate_row_count": {
          "type": "string"
        },
        "invalid_query_id_count": {
          "type": "string"
        },
        "metric_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuditMetricCoverage"
          }
        },
        "missing_context_count": {
          "type": "string"
        },
        "missing_digest_count": {
          "type": "string"
        },
        "raw_row_count": {
          "type": "string"
        },
        "retained_event_count": {
          "type": "string"
        },
        "retained_family_count": {
          "type": "string"
        },
        "statement_filter": {
          "description": "Raw source rows in the same window and field filters that the explicit statement-class filter hid. Never folded into `raw_row_count`.",
          "allOf": [
            {
              "$ref": "#/definitions/AuditStatementFilterCoverage"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "AuditErrorCodeFact": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "$ref": "#/definitions/AuditOptionalFactUnavailableReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "unavailable"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "sql_null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "text"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "AuditErrorProportion": {
      "description": "Exact numerator/denominator facts for a family's source ERR proportion. Decimal strings deliberately avoid a lossy percentage or JSON number.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "denominator",
            "numerator",
            "state"
          ],
          "properties": {
            "denominator": {
              "type": "string"
            },
            "numerator": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "exact"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "denominator",
            "numerator",
            "state"
          ],
          "properties": {
            "denominator": {
              "type": "string"
            },
            "numerator": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "not_applicable"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "$ref": "#/definitions/AuditErrorProportionUnavailableReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "unavailable"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "$ref": "#/definitions/AuditErrorProportionInvalidReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "invalid"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "AuditErrorProportionInvalidReason": {
      "type": "string",
      "enum": [
        "error_count_invalid",
        "execution_count_invalid",
        "numerator_exceeds_denominator"
      ]
    },
    "AuditErrorProportionUnavailableReason": {
      "type": "string",
      "enum": [
        "legacy_field_absent",
        "error_count_missing",
        "execution_count_missing"
      ]
    },
    "AuditFamilyContext": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": [
            "string",
            "null"
          ]
        },
        "cluster": {
          "type": [
            "string",
            "null"
          ]
        },
        "database": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "AuditFamilyMembership": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "context",
            "family_key",
            "native_digest",
            "state"
          ],
          "properties": {
            "context": {
              "$ref": "#/definitions/AuditFamilyContext"
            },
            "family_key": {
              "type": "string"
            },
            "native_digest": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "exact_native_digest"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "$ref": "#/definitions/AuditUngroupedReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "ungrouped"
              ]
            }
          }
        }
      ]
    },
    "AuditFamilyPresentation": {
      "type": "object",
      "required": [
        "aggregates",
        "membership"
      ],
      "properties": {
        "aggregates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuditAggregateFact"
          }
        },
        "error_count": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_proportion": {
          "description": "Old retained golden fixtures omit this field. New API responses always emit a typed fact instead of inferring a rate from missing counters.",
          "default": {
            "state": "unavailable",
            "reason": "legacy_field_absent"
          },
          "allOf": [
            {
              "$ref": "#/definitions/AuditErrorProportion"
            }
          ]
        },
        "execution_count": {
          "type": [
            "string",
            "null"
          ]
        },
        "membership": {
          "$ref": "#/definitions/AuditFamilyMembership"
        },
        "statement_sample": {
          "description": "The audited `stmt` of the family's most recent member, as a bounded character prefix. It is one real member's source text, never a normalized or parameterized family SQL. Old fixtures omit it.",
          "default": {
            "state": "unavailable",
            "reason": "not_read"
          },
          "allOf": [
            {
              "$ref": "#/definitions/AuditStatementSample"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "AuditMetricCoverage": {
      "type": "object",
      "required": [
        "aggregate",
        "metric_id",
        "negative_count",
        "nonnegative_count",
        "sql_null_count",
        "text_present_count"
      ],
      "properties": {
        "aggregate": {
          "$ref": "#/definitions/AuditAggregateFact"
        },
        "metric_id": {
          "$ref": "#/definitions/AuditMetricId"
        },
        "negative_count": {
          "type": "string"
        },
        "nonnegative_count": {
          "type": "string"
        },
        "sql_null_count": {
          "type": "string"
        },
        "text_present_count": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AuditMetricFact": {
      "type": "object",
      "required": [
        "input",
        "metric_id",
        "state"
      ],
      "properties": {
        "canonical_number": {
          "description": "Decimal text only; never encode audit counters as a JSON number.",
          "anyOf": [
            {
              "$ref": "#/definitions/CanonicalNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "input": {
          "$ref": "#/definitions/AuditMetricInput"
        },
        "metric_id": {
          "$ref": "#/definitions/AuditMetricId"
        },
        "parser_state": {
          "anyOf": [
            {
              "$ref": "#/definitions/ParseState"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/definitions/AuditMetricState"
        }
      },
      "additionalProperties": false
    },
    "AuditMetricId": {
      "type": "string",
      "enum": [
        "query_time",
        "pending_time",
        "scan_bytes",
        "scan_rows",
        "cpu_cost",
        "memory_cost",
        "return_rows"
      ]
    },
    "AuditMetricInput": {
      "description": "Lossless transport input. `Text(\"0\")` is deliberately distinct from SQL NULL and remains decimal text so JavaScript never receives a lossy number.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "sql_null"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "text"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "$ref": "#/definitions/AuditOptionalFactUnavailableReason"
            },
            "state": {
              "type": "string",
              "enum": [
                "unavailable"
              ]
            }
          }
        }
      ]
    },
    "AuditMetricState": {
      "description": "This is a result state, not a second parser. The core AuditLoader adapter must map its one typed-parser outcome and audit-only negative policy here.",
      "type": "string",
      "enum": [
        "exact",
        "missing",
        "invalid",
        "negative_sentinel",
        "overflow",
        "precision_unsafe",
        "unavailable"
      ]
    },
    "AuditOccurrencePresentation": {
      "type": "object",
      "required": [
        "family",
        "metrics",
        "query"
      ],
      "properties": {
        "catalog": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "description": "AuditLoader's optional `errorCode` source fact. An empty source string is deliberately not a SQL NULL or a missing source column.",
          "default": {
            "state": "unavailable",
            "reason": "source_column_absent"
          },
          "allOf": [
            {
              "$ref": "#/definitions/AuditErrorCodeFact"
            }
          ]
        },
        "family": {
          "$ref": "#/definitions/AuditFamilyMembership"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuditMetricFact"
          }
        },
        "query": {
          "$ref": "#/definitions/ConnectedQueryRef"
        },
        "statement_sample": {
