{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorrelationEvidence",
  "type": "object",
  "required": [
    "baseline_analysis_key",
    "baseline_analysis_receipt",
    "baseline_origin",
    "baseline_source_hash",
    "baseline_source_kind",
    "candidate_explain_snapshot_id",
    "candidate_origin",
    "candidate_plan_hash",
    "source_refs"
  ],
  "properties": {
    "baseline_analysis_key": {
      "type": "string"
    },
    "baseline_analysis_receipt": {
      "$ref": "#/definitions/AnalysisReceipt"
    },
    "baseline_origin": {
      "$ref": "#/definitions/InputOrigin"
    },
    "baseline_source_hash": {
      "type": "string"
    },
    "baseline_source_kind": {
      "$ref": "#/definitions/SourceKind"
    },
    "candidate_explain_snapshot_id": {
      "type": "string"
    },
    "candidate_origin": {
      "$ref": "#/definitions/InputOrigin"
    },
    "candidate_plan_hash": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AnalysisReceipt": {
      "type": "object",
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReceiptComponent"
          }
        }
      }
    },
    "InputOrigin": {
      "type": "string",
      "enum": [
        "offline_import",
        "connected_profile_fetch",
        "candidate_profile_user_external_rerun",
        "connected_explain",
        "connected_sql_runtime"
      ]
    },
    "ReceiptComponent": {
      "type": "object",
      "required": [
        "id",
        "manifest_hash",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "manifest_hash": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "SourceKind": {
      "type": "string",
      "enum": [
        "json_profile",
        "text_profile"
      ]
    }
  }
}
