{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExplainCardFactSlot",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "expected_fact_kind",
        "fact_ref",
        "reason_codes",
        "selection_recipe",
        "slot_id",
        "source_refs",
        "state"
      ],
      "properties": {
        "expected_fact_kind": {
          "$ref": "#/definitions/ExplainFactKind"
        },
        "fact_ref": {
          "type": "string"
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 0
        },
        "selection_recipe": {
          "$ref": "#/definitions/RecipeRef"
        },
        "slot_id": {
          "$ref": "#/definitions/ExplainCardSlotId"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "selected"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "expected_fact_kind",
        "fact_ref",
        "reason_codes",
        "selection_recipe",
        "slot_id",
        "source_refs",
        "state"
      ],
      "properties": {
        "expected_fact_kind": {
          "$ref": "#/definitions/ExplainFactKind"
        },
        "fact_ref": {
          "type": "null"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "selection_recipe": {
          "$ref": "#/definitions/RecipeRef"
        },
        "slot_id": {
          "$ref": "#/definitions/ExplainCardSlotId"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "unavailable"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "expected_fact_kind",
        "fact_ref",
        "reason_codes",
        "selection_recipe",
        "slot_id",
        "source_refs",
        "state"
      ],
      "properties": {
        "expected_fact_kind": {
          "type": "null"
        },
        "fact_ref": {
          "type": "null"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "selection_recipe": {
          "$ref": "#/definitions/RecipeRef"
        },
        "slot_id": {
          "$ref": "#/definitions/ExplainCardSlotId"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "not_applicable"
          ]
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "ExplainCardSlotId": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "tertiary"
      ]
    },
    "ExplainFactKind": {
      "description": "The small, version-pinned set of plan facts that an Explain-only card may render.  These are estimates or structural facts, never runtime metrics.",
      "type": "string",
      "enum": [
        "cardinality_estimate",
        "distribution",
        "join_strategy",
        "aggregate_phase",
        "plan_child_count"
      ]
    },
    "RecipeRef": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
