{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorEnvelope",
  "type": "object",
  "required": [
    "code",
    "details",
    "message_id",
    "recoverability",
    "request_id",
    "source_refs",
    "stage"
  ],
  "properties": {
    "affected_side": {
      "type": [
        "string",
        "null"
      ]
    },
    "code": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "message_id": {
      "type": "string"
    },
    "recoverability": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "type": "string"
    }
  }
}
