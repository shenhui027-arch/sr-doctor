{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExplainReceipt",
  "description": "Receipts that pin the independently versioned Explain surface.  Each component hash is over its actual fixed semantic content. These are available surface pins, not proof that every recipe was applied. Raw-text modes explicitly mark COSTS recipes as not applied in limitations.",
  "type": "object",
  "required": [
    "adapter",
    "card_facts_recipe",
    "exchange_recipe",
    "schema"
  ],
  "properties": {
    "adapter": {
      "$ref": "#/definitions/ReceiptComponent"
    },
    "card_facts_recipe": {
      "$ref": "#/definitions/ReceiptComponent"
    },
    "exchange_recipe": {
      "$ref": "#/definitions/ReceiptComponent"
    },
    "schema": {
      "$ref": "#/definitions/ReceiptComponent"
    },
    "version_pack": {
      "anyOf": [
        {
          "$ref": "#/definitions/ReceiptComponent"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ReceiptComponent": {
      "type": "object",
      "required": [
        "id",
        "manifest_hash",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "manifest_hash": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
