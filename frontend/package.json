{
  "name": "sr-doctor-frontend",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run verify:bundles",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "verify:bundles": "node ../scripts/release/verify-frontend-bundles.mjs --dist dist --policy private-v0.2-size-observation"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@xyflow/react": "^12.11.5",
    "elkjs": "0.12.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
